# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored, so nothing here reaches GitHub.
#
# All of these are read on the SERVER only. Anything named NEXT_PUBLIC_* would
# be sent to the browser, which is exactly why none of these are.

# Anthropic API key — https://console.anthropic.com → Settings → API keys
ANTHROPIC_API_KEY=sk-ant-...

# Single shared password for the whole site. Leave this unset locally if you
# would rather not type a password every time; the gate switches itself off
# when it is missing. It must be set in Vercel.
SITE_PASSWORD=

# Supabase. Added automatically to Vercel by the Supabase integration; copy
# them into .env.local for local development.
# The service role key bypasses row-level security — server-side only, never
# in the browser, never committed.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Keepa, for real Amazon sales rank and price history (Phase 6).
# From keepa.com/#!api once subscribed. API access is a paid tier.
KEEPA_API_KEY=
